# Bluetooth Refill
entities.WrenbowHelper/BluetoothRefill.placements.name.bluetooth_refill=Bluetooth Refill
entities.WrenbowHelper/BluetoothRefill.placements.description.bluetooth_refill=Refill crystal that can be collected by holdables
entities.WrenbowHelper/BluetoothRefill.attributes.description.spritePath=Path to a custom sprite folder from Gameplay/. (Expected to contain at least an idle00, flash00, and outline)
entities.WrenbowHelper/BluetoothRefill.attributes.description.spriteColor=Tint color
entities.WrenbowHelper/BluetoothRefill.attributes.description.respawnTime=Time to respawn in seconds
entities.WrenbowHelper/BluetoothRefill.attributes.description.freezeFrames=Number of freeze frames to apply on collect
entities.WrenbowHelper/BluetoothRefill.attributes.description.collectSound=Sound event to play on collect
entities.WrenbowHelper/BluetoothRefill.attributes.description.playerCollect=Whether this refill can also be collected by the player
entities.WrenbowHelper/BluetoothRefill.attributes.description.triggerViaDashCount=Whether the refill can be collected due to the player not being at max dashes
entities.WrenbowHelper/BluetoothRefill.attributes.description.triggerViaStamina=Whether the refill can be collected due to the player being at low stamina
entities.WrenbowHelper/BluetoothRefill.attributes.description.triggerAlways=If enabled, will be collected regardless of the player's current dash count or stamina. Overrides the other trigger settings
entities.WrenbowHelper/BluetoothRefill.attributes.description.moreOptions=Shows advanced options (reload this dialog box to see them)

# Dream Jump Refill
entities.WrenbowHelper/DreamJumpRefill.placements.name.dream_jump_refill=Dream Jump Refill
entities.WrenbowHelper/DreamJumpRefill.placements.description.dream_jump_refill=Allows for a second non-buffered dream jump (i.e. dtj)
entities.WrenbowHelper/DreamJumpRefill.attributes.description.earlyLeniencyFrames=Extra leniency coyote frames to be applied on dream block exit. These can carry over to a second non-buffered jump
entities.WrenbowHelper/DreamJumpRefill.attributes.description.lateLeniencyFrames=Extra leniency coyote frames to be applied after the first non-buffered jump
entities.WrenbowHelper/DreamJumpRefill.attributes.description.persistent=Allows the stored jump to be retained past the next dream block exit if not used
entities.WrenbowHelper/DreamJumpRefill.attributes.description.trailIndicator=Whether to show a trail when a dream jump is either stored or usable. If custom indication is desired, the flag "WrenbowHelper_HasDreamJump" follows this behavior
entities.WrenbowHelper/DreamJumpRefill.attributes.description.trailColor=Color of the indicator trail

# Set LiftSpeed Trigger
triggers.WrenbowHelper/SetLiftSpeedTrigger.placements.name.set_liftspeed_trigger=Set LiftSpeed Trigger
triggers.WrenbowHelper/SetLiftSpeedTrigger.placements.description.set_liftspeed_trigger=Forcibly sets  the player's LiftSpeed (to be used for LiftBoost)
triggers.WrenbowHelper/SetLiftSpeedTrigger.attributes.description.liftSpeedX=Horizontal LiftSpeed to give (note: LiftBoost usually capped to +-250)
triggers.WrenbowHelper/SetLiftSpeedTrigger.attributes.description.liftSpeedY=Vertical LiftSpeed to give (note: LiftBoost usually capped to 0,-130)
triggers.WrenbowHelper/SetLiftSpeedTrigger.attributes.description.onlyOnce=Removes the trigger when LiftSpeed is first given
triggers.WrenbowHelper/SetLiftSpeedTrigger.attributes.description.sustainedOverride=Prevents other sources' liftspeed from applying until the overridden value runs out 
triggers.WrenbowHelper/SetLiftSpeedTrigger.attributes.description.flag=Flag that must be true to give LiftSpeed

# Dream Block LiftSpeed Fix Trigger
triggers.WrenbowHelper/DreamBlockLiftSpeedFixTrigger.placements.name.dream_block_liftspeed_fix_trigger=Dream Block LiftSpeed Fix Trigger
triggers.WrenbowHelper/DreamBlockLiftSpeedFixTrigger.placements.description.dream_block_liftspeed_fix_trigger=Enables dream block liftspeed fix (gives the dream block's liftspeed when entering stDreamDash)
triggers.WrenbowHelper/DreamBlockLiftSpeedFixTrigger.attributes.description.value=Whether the fix will be active

# Rubiks Cube
entities.WrenbowHelper/RubiksCube.placements.name.rubiks_cube=Rubiks Cube
entities.WrenbowHelper/RubiksCube.placements.description.rubiks_cube=A Rubiks Cube\nEither initialises a new cube when loaded, or reflects an already loaded cube if the name is not unique\nCurrently only available as a 2D net
entities.WrenbowHelper/RubiksCube.attributes.description.cubeLayout=Which layout to use (more coming soon)
entities.WrenbowHelper/RubiksCube.attributes.description.solvedFlag=Flag that will be true when the cube is in a solved state\nThe flag will not be updated if there is no cube loaded
entities.WrenbowHelper/RubiksCube.attributes.description.lockOnSolve=Prevents the cube from being turned once solved
entities.WrenbowHelper/RubiksCube.attributes.description.cubeName=Identifier to store the puzzle state to/reflect from
entities.WrenbowHelper/RubiksCube.attributes.description.persistent=Whether to keep the cube state saved when leaving the screen
entities.WrenbowHelper/RubiksCube.attributes.description.colorPalette=Set of 6 colors to shift the sticker texture by\nA colorblind option is always available to the player as a mod setting to give each "color" a unique icon as well

# Rubiks Watchtower
entities.WrenbowHelper/RubiksWatchtower.placements.name.rubiks_watchtower=Rubiks Watchtower
entities.WrenbowHelper/RubiksWatchtower.placements.description.rubiks_watchtower=Bino that allows control of a Rubiks Cube state
entities.WrenbowHelper/RubiksWatchtower.attributes.description.cubeLayout=The display layout of the cube this bino should control (slightly affects inputs)
entities.WrenbowHelper/RubiksWatchtower.attributes.description.cubeName=Cube state identifier to pair to

# Turn Rubiks Cube Trigger
triggers.WrenbowHelper/TurnRubiksCubeTrigger.placements.name.turn_rubiks_cube_trigger=Turn Rubiks Cube Trigger
triggers.WrenbowHelper/TurnRubiksCubeTrigger.placements.description.turn_rubiks_cube_trigger=Can either perform a specific turn, or select a single component of a turn to be applied later
triggers.WrenbowHelper/TurnRubiksCubeTrigger.attributes.description.layer=0 is the outermost layer, and it counts up moving inward. This can not turn slices past the middle of the cube relative to the turn face
triggers.WrenbowHelper/TurnRubiksCubeTrigger.attributes.description.cubeName=Cube state identifier to pair to
triggers.WrenbowHelper/TurnRubiksCubeTrigger.attributes.description.operation=Select ___: Select a single turn component for the cube\nTurn Selection: If a face, layer, and direction have been selected, perform the turn\nAll: Bypass the selection system and directly apply the turn

triggers.WrenbowHelper/ScrambleRubiksCubeTrigger.placements.name.scramble_rubiks_cube_trigger=Scramble Rubiks Cube Trigger
triggers.WrenbowHelper/ScrambleRubiksCubeTrigger.placements.description.scramble_rubiks_cube_trigger=Applies a configurable amount of random turns to a Rubiks Cube state
triggers.WrenbowHelper/ScrambleRubiksCubeTrigger.attributes.description.cubeName=Cube state identifier to pair to
triggers.WrenbowHelper/ScrambleRubiksCubeTrigger.attributes.description.scrambleLength=How many turns to apply
triggers.WrenbowHelper/ScrambleRubiksCubeTrigger.attributes.description.doOnce=Delete this trigger after successfully applying a scramble (can fail if unpaired or the cube is locked)